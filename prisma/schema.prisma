// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Core domain models ---

// Auth is username + PIN (hashed), not email — closed group, no email sending needed.
// A member is seeded with a username and a null pinHash; the first sign-in with that
// username prompts them to choose a PIN, which then locks in for future logins.
// Sessions are JWT-based (Auth.js Credentials provider doesn't use a DB adapter).
model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  name                String?
  // A single emoji shown to the left of the person's name across the app -- purely
  // cosmetic, admin-editable (see app/admin/), used for in-group ribbing after a blunder.
  flair               String?
  pinHash             String?
  // Failed-PIN lockout: after MAX_FAILED_ATTEMPTS (lib/pin.ts) wrong guesses in a row,
  // lockedUntil is set and login is refused until it passes, regardless of PIN correctness.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  image               String?
  createdAt           DateTime  @default(now())

  memberships    GroupMember[]
  legs           Leg[]
  createdParlays Parlay[]      @relation("ParlayCreator")
}

enum Role {
  MEMBER
  ADMIN
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members GroupMember[]
  parlays Parlay[]
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  userId  String
  role    Role   @default(MEMBER)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// An ad hoc slate of games a parlay is built against, e.g. "NFL, Sunday 1:00pm-4:00pm, '1 o'clock games'".
// Created fresh per parlay -- there is no reusable "week" concept, so the group can fire off as many
// windows as they want per day across any sport.
model Window {
  id       String   @id @default(cuid())
  league   String // free text, e.g. "NFL", "NBA" -- not an enum, so unlisted sports still work
  label    String? // free text, e.g. "1 o'clock games", "SNF"
  startsAt DateTime
  endsAt   DateTime
  // True only for Free-for-all parlays -- the 5 NFL presets leave this false. Free-for-all
  // legs can each be a different sport (an NBA pick here, an MLB pick there), so `league`
  // above is just this window's decorative/display label; the real per-leg sport lives on
  // each Game instead. This flag is what tells PickLegForm whether to show a per-pick
  // Sport selector (true) or treat the whole window as one fixed league like NFL (false).
  isFreeForAll Boolean @default(false)

  games   Game[]
  parlays Parlay[]
}

enum GameStatus {
  SCHEDULED
  LIVE
  FINAL
}

model Game {
  id           String     @id @default(cuid())
  windowId     String
  externalId   String? // provider event id (The Odds API or ESPN's schedule); null in manual-entry mode
  // The sport this specific game belongs to (e.g. "NFL", "NBA"), set from whatever the
  // picker chose at pick time. Nullable since rows created before this field existed
  // can't be retroactively known; new picks always set it, same backfill-only-if-null
  // discipline externalId already uses.
  league       String?
  homeTeam     String
  awayTeam     String
  commenceTime DateTime
  status       GameStatus @default(SCHEDULED)
  homeScore    Int?
  awayScore    Int?
  completedAt  DateTime?

  window        Window         @relation(fields: [windowId], references: [id], onDelete: Cascade)
  oddsSnapshots OddsSnapshot[]
  legs          Leg[]

  @@unique([windowId, externalId])
}

enum Market {
  SPREAD
  TOTAL
  MONEYLINE
  PLAYER_PROP // player prop, over/under a numeric line (e.g. "Mahomes passing yards")
  PLAYER_PROP_YESNO // player prop with no line, just yes/no (e.g. "anytime TD")
}

enum Side {
  HOME
  AWAY
  OVER
  UNDER
  YES
  NO
}

// Point-in-time line/price for a game+market+bookmaker. Unused substantively until live-odds
// integration lands, but the shape exists from day one so line-history/staleness has a home.
model OddsSnapshot {
  id        String   @id @default(cuid())
  gameId    String
  market    Market
  bookmaker String
  homeLine  Float?
  awayLine  Float?
  homePrice Int?
  awayPrice Int?
  source    String // "theoddsapi" | "mock" | "manual"
  fetchedAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId, market, fetchedAt])
}

enum ParlayStatus {
  OPEN
  LOCKED
  RESOLVED
  VOID
}

enum LegResult {
  PENDING
  WIN
  LOSS
  PUSH
}

model Parlay {
  id              String       @id @default(cuid())
  groupId         String
  windowId        String
  creatorId       String
  title           String?
  status          ParlayStatus @default(OPEN)
  countsForRecord Boolean      @default(true)
  // Wager amount the creator sets at creation, used with the legs' prices to compute
  // combined odds and a payout figure. Defaulted for parlays created before this existed.
  stake           Float        @default(10)
  // American odds (e.g. -150), manually entered by any member to override the naive
  // product-of-independent-legs figure computeCombinedOdds would otherwise show. Needed
  // because legs from the same game are correlated -- a real sportsbook prices a same-game
  // parlay differently than multiplying each leg's standalone price, and we have no way to
  // derive that correlated number ourselves. Null means "use the computed value."
  oddsOverride    Int?
  result          LegResult    @default(PENDING)
  createdAt       DateTime     @default(now())
  lockedAt        DateTime?
  resolvedAt      DateTime?

  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  window  Window @relation(fields: [windowId], references: [id], onDelete: Cascade)
  creator User   @relation("ParlayCreator", fields: [creatorId], references: [id])
  legs    Leg[]
}

enum LegStatus {
  CONFIRMED
  STALE
}

enum Badge {
  NONE
  MONEYBAG
  POO
  TOILET
  CROSS
}

// At most one leg per member per parlay -- a member may have zero if they sit a week out.
// A parlay can lock with 2-4 legs present; it isn't hard-blocked at exactly 4.
model Leg {
  id          String    @id @default(cuid())
  parlayId    String
  userId      String
  gameId      String
  market      Market
  side        Side
  lineAtPick  Float?
  priceAtPick Int?
  // Set only when market is PLAYER_PROP or PLAYER_PROP_YESNO; null for team markets.
  playerName  String?
  propType    String? // free text, e.g. "Passing Yards", "Anytime TD"
  status      LegStatus @default(CONFIRMED)
  result      LegResult @default(PENDING)
  badge       Badge     @default(NONE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parlay Parlay @relation(fields: [parlayId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  game   Game   @relation(fields: [gameId], references: [id])

  @@unique([parlayId, userId])
}

// Seam for future in-app banners / web push -- not consumed by push in v1.
model EventLog {
  id        String   @id @default(cuid())
  groupId   String
  type      String // "LEG_STALE" | "PARLAY_LOCKED" | "PARLAY_RESOLVED"
  payload   Json
  createdAt DateTime @default(now())
}
